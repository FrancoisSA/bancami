# Copier ce fichier en .env et remplir les valeurs
# NE PAS commiter .env dans git

# Token du bot Telegram (obtenu via @BotFather)
TELEGRAM_BOT_TOKEN=ton_token_ici

# Clé API Anthropic Claude
ANTHROPIC_API_KEY=ta_clé_ici

# Ton user_id Telegram numérique (obtenu via @userinfobot)
TELEGRAM_USER_ID=ton_id_numerique_ici

# Fichiers de données (chemins relatifs au dossier projet)
DATA_FILE=transactions.json
MERCHANTS_FILE=merchants.json

# Modèle Claude à utiliser (optionnel, défaut : claude-sonnet-4-5)
# CLAUDE_MODEL=claude-sonnet-4-5
